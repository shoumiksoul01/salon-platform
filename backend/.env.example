# Copy this file to backend/.env (git-ignored) and fill in the values.
# Never commit .env and never paste these values into a chat.

# Supabase: Project Settings, Database, Connection string. Use the Session pooler
# string (port 5432) and put the database password in it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase: Project Settings, API. Project URL, and the service_role key (secret).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only if the project still signs tokens with the old shared secret
# (Project Settings, JWT Keys, Legacy JWT Secret). New projects leave this empty.
SUPABASE_JWT_SECRET=

# Frontend address(es) allowed by CORS, separated by commas.
FRONTEND_ORIGIN=http://localhost:5173
